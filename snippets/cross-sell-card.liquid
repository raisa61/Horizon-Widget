{%- doc -%}
  Renders a single Cross sell product card.

  @param {product} cross_product - Product to render
  @param {boolean} has_single_variant - Whether the product has only one variant
  @param {object} default_variant - Pre-selected variant
{%- enddoc -%}

<div class="cross-sell__card" data-cross-sell-card>
  <div class="cross-sell__image-wrap">
    {%- if cross_product.featured_image -%}
      {%- liquid
        assign image = cross_product.featured_image
        assign image_height = 200
        assign image_height_2x = image_height | times: 2
        assign image_height_3x = image_height | times: 3
        assign image_width = image_height | times: image.aspect_ratio | round
        assign image_alt_text = image.alt | default: cross_product.title | escape
      -%}
      {%- capture image_srcset -%}
        {{ image | image_url: height: image_height }} 1x, {{ image | image_url: height: image_height_2x }} 2x, {{ image | image_url: height: image_height_3x }} 3x
      {%- endcapture -%}
      <img
        src="{{ image | image_url: height: image_height }}"
        srcset="{{ image_srcset | strip }}"
        alt="{{ image_alt_text }}"
        loading="lazy"
        width="{{ image_width }}"
        height="{{ image_height }}"
        class="cross-sell__image"
        data-cross-sell-image
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'cross-sell__image' }}
    {%- endif -%}
  </div>

  <div class="cross-sell__info">
    {%- render 'cross-sell-info', cross_product: cross_product, default_variant: default_variant -%}

    {%- render 'cross-sell-form',
      cross_product: cross_product,
      has_single_variant: has_single_variant,
      default_variant: default_variant
    -%}
  </div>
</div>
