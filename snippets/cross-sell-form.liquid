{%- liquid
  assign form_id = 'cross-sell-' | append: cross_product.id
  assign fly_image = cross_product.featured_image | image_url: width: 100
-%}

<product-form-component
  id="{{ form_id }}-component"
  class="cross-sell__form"
  data-product-id="{{ cross_product.id }}"
  data-quantity-default="1"
  on:submit="/handleSubmit"
>
  {%- form 'product', cross_product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
    <input
      type="hidden"
      name="id"
      ref="variantId"
      data-cross-sell-variant-id
      value="{% if has_single_variant %}{{ cross_product.variants.first.id }}{% else %}{{ default_variant.id }}{% endif %}"
    >

    <input
      type="hidden"
      name="quantity"
      value="1"
    >

    <div class="cross-sell__controls">
      {%- unless has_single_variant -%}
        <div class="cross-sell__select-wrap">
          <select
            class="cross-sell__select"
            on:change="cross-sell-component/handleChange"
            name="cross_sell_variant"
            aria-label="{{ cross_product.options.first }}"
          >
            <option value="" disabled selected>
              {{ cross_product.options.first | upcase }}
            </option>

            {%- for variant in cross_product.variants limit: 250 -%}
              {%- assign variant_media = variant.image | default: cross_product.featured_image -%}
              {%- capture variant_image_srcset -%}
              {%- if variant_media -%}
                  {{ variant_media | image_url: width: 300 }} 300w,
                  {{ variant_media | image_url: width: 400 }} 400w,
                  {{ variant_media | image_url: width: 600 }} 600w
              {%- endif -%}
            {%- endcapture -%}
              {%- assign variant_alt = variant_media.alt | default: variant.title -%}
              {%- capture variant_json -%}
              {
                "price": {{ variant.price | money | json }},
                "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                "available": {{ variant.available | json }},
                "image": {% if variant_media %}{{ variant_media | image_url: width: 400 | json }}{% else %}null{% endif %},
                "imageSrcset": {% if variant_media %}{{ variant_image_srcset | strip | json }}{% else %}null{% endif %},
                "imageSizes": "(min-width: 1400px) 15.5rem, (min-width: 750px) 12.5rem, 9.5rem",
                "flyImage": {% if variant_media %}{{ variant_media | image_url: width: 100 | json }}{% else %}null{% endif %},
                "alt": {{ variant_alt | json }}
              }
            {%- endcapture -%}

              <option
                value="{{ variant.id }}"
                data-variant="{{ variant_json | escape }}"
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {{ variant.title -}}
                {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endunless -%}

      <add-to-cart-component
        ref="addToCartButtonContainer"
        class="cross-sell__add-wrap"
        data-add-to-cart-animation="true"
        data-product-variant-media="{{ fly_image }}"
        on:click="/handleClick"
      >
        <button
          ref="addToCartButton"
          type="submit"
          name="add"
          class="button cross-sell__add"
          data-cross-sell-add
          {% if has_single_variant %}
            {% unless cross_product.variants.first.available %}disabled{% endunless %}
          {% else %}
            disabled
          {% endif %}
        >
          <span>
            {{ 'actions.add' | t }}
          </span>
        </button>
      </add-to-cart-component>
    </div>

    <div
      class="cross-sell__live-region"
      role="status"
      ref="liveRegion"
    ></div>
  {%- endform -%}
</product-form-component>
