{%- doc -%}
  Displays cross-sell products for the closest product.
  Products come from the Cross Sell Products metafield (type: List of products).
{%- enddoc -%}

{% liquid
  assign cross_sell_products = closest.product.metafields.custom.cross_sell_products.value
%}

{% if cross_sell_products.size > 0 %}
  {% render 'cross-sell-widget',
    cross_sell_products: cross_sell_products,
    heading: block.settings.heading,
    products_to_show: block.settings.products_to_show,
    shopify_attributes: block.shopify_attributes
  %}
{% elsif request.design_mode %}
  <div class="cross-sell cross-sell--empty" {{ block.shopify_attributes }}>
    <p>Add Products in the Cross Sell Metafield</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Cross-sell",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs With"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "checkbox",
      "id": "background",
      "label": "t:settings.background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.background }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Cross-sell"
    }
  ]
}
{% endschema %}
